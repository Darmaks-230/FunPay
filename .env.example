DISCORD_TOKEN=
FUNPAY_GOLDEN_KEY=

TABLE_CHANNEL_ID=
ORDER_ROLE_ID=
STALE_CHANNEL_ID=

ADMIN_CHAT_IDS=

#Сообщения в дс
FUNPAY_OWNER_ID=
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
DISCORD_EVENTS_CHANNEL_ID=
DISCORD_WEBHOOK_NAME=FunPay
DISCORD_WEBHOOK_AVATAR=

#Автоподнятие
# false — реально поднимать предложения
# true — только показать найденные ID
DRY_RUN=false
# Пауза между попытками
DELAY_SECONDS=10
# Повторять цикл каждые N минут
INTERVAL_MINUTES=30

#Starvell
# Cookie «session» с starvell.com (F12 → Application → Cookies)
STARVELL_SESSION=
# Чаты Starvell идут в категорию FunPay (каналы starvell-ник), события — в общий канал событий
STARVELL_WEBHOOK_NAME=Starvell
# Автоподнятие лотов Starvell
STARVELL_RAISE=true
STARVELL_RAISE_MINUTES=30
